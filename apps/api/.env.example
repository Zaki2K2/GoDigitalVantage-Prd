NODE_ENV=development
PORT=3100
MONGODB_URI=mongodb://127.0.0.1:27017/godigitalvantage
# For phone testing add the development computer's actual LAN origin, for example:
# CORS_ORIGIN=http://localhost:4200,http://192.168.1.10:4200
CORS_ORIGIN=http://go-digital-vantage-prd.vercel.app
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-too-at-least-32-characters
# Replace localhost with the computer's LAN IPv4 address before printing/scanning on a phone.
# This controls the URL encoded in every QR; restart the API after changing it.
PUBLIC_APP_BASE_URL=http://go-digital-vantage-prd.vercel.app
# PUBLIC_BASE_URL remains supported for existing installations; PUBLIC_APP_BASE_URL takes priority.
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=20
PUBLIC_SUBMIT_RATE_LIMIT_MAX=10
PUBLIC_SCAN_RATE_LIMIT_MAX=60
# Shared rate-limit counters: `mongo` on serverless (Vercel), `memory` locally.
RATE_LIMIT_STORE=memory
# Behind Vercel rewrite + a host load balancer set the number of proxy hops (usually 2); 0 when exposed directly.
TRUST_PROXY=0

# Transactional email (API only; keep disabled until domain verification + secrets).
EMAIL_PROVIDER=resend
EMAIL_ENABLED=false
# Configure the production scheduler separately. Omit this secret to disable scheduler access.
# CRON_SECRET=replace-with-at-least-32-random-characters
# Permanent independent secret for unsubscribe links; required for production campaign delivery.
# MARKETING_UNSUBSCRIBE_SECRET=replace-with-at-least-32-random-characters
EMAIL_TEST_MODE=false
# Exact email used to sign up for Resend; no other test recipients allowed.
RESEND_TEST_EMAIL=
RESEND_TEST_FROM_EMAIL="GoDigitalVantage <onboarding@resend.dev>"
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET="whsec_oRflNlixcX+lBOtK/B6J3W8CoQhMVcZC"
RESEND_FROM_EMAIL="GoDigitalVantage <notifications@mail.godigitalvantage.com>"
RESEND_REWARDS_FROM_EMAIL="GoDigitalVantage Rewards <rewards@mail.godigitalvantage.com>"
RESEND_VERIFY_FROM_EMAIL="GoDigitalVantage Verification <verify@mail.godigitalvantage.com>"
RESEND_SECURITY_FROM_EMAIL="GoDigitalVantage Security <security@mail.godigitalvantage.com>"
# REQUIRED for Instant Rewards emails (>=32 chars; the API still starts without it, but reward
# delivery fails with EMAIL_NOT_CONFIGURED). Never overwrite an existing value: issued links would break.
# INSTANT_REWARDS_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Opt-in safe per-request timings in Vercel logs and startup/connect Server-Timing headers.
# Never includes URLs, user IDs, request bodies, cookies, queries or connection strings.
PERFORMANCE_LOGGING=false

# WhatsApp Cloud API follow-up (optional; free Meta test credentials are enough for development).
# Follow-ups are only ever sent when a signed-in business owner clicks Send. Secrets stay on the API.
WHATSAPP_ENABLED=false
# Meta developer app > WhatsApp > API Setup: temporary token, or a System User token for longer use.
WHATSAPP_ACCESS_TOKEN=
# The numeric "Phone number ID" of the test number (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Meta app > Settings > Basic > App secret. Used to verify webhook X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Any random string (8+ chars) you also type into the webhook "Verify token" field in Meta.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Local mock testing only (rejected in production): WHATSAPP_GRAPH_BASE_URL=http://127.0.0.1:3198
# Used when the customer has not messaged in the last 24h. The test number includes hello_world.
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
