# GoDigitalVantage API: production template (Vercel API project). Placeholders only: safe to commit.
# Copy to .env.production (git-ignored), fill in, then import into Vercel.
NODE_ENV=production
# Atlas string: keep the host/database, use the real (rotated) password, URL-encode special characters.
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/godigitalvantage?retryWrites=true&w=majority
# Two DIFFERENT random values, 32+ characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=<generate>
JWT_REFRESH_SECRET=<generate>
# Public URL of the WEB project (not the API).
CORS_ORIGIN=https://<web-project>.vercel.app
PUBLIC_APP_BASE_URL=https://<web-project>.vercel.app
# Legacy name, still accepted (PUBLIC_APP_BASE_URL wins).
PUBLIC_BASE_URL=https://<web-project>.vercel.app
# Shared rate-limit counters across serverless instances.
RATE_LIMIT_STORE=mongo
# Vercel edge is the only proxy in front of the function; verify the client IP the API sees.
TRUST_PROXY=1
