# Production / testing deployment template. Copy these into the API host's environment settings.
# Never commit real values: this file only holds placeholders.
NODE_ENV=production
MONGODB_URI=your_mongodb_atlas_uri
# Random, at least 32 characters each, and different from each other (e.g. `openssl rand -base64 48`).
JWT_ACCESS_SECRET=your_secure_access_secret
JWT_REFRESH_SECRET=your_secure_refresh_secret
CORS_ORIGIN=https://demo-godigitalvantage.vercel.app
# Address encoded in every QR code.
PUBLIC_APP_BASE_URL=https://demo-godigitalvantage.vercel.app
# Vercel Functions: shared rate-limit counters in MongoDB (in-memory counters are per instance).
RATE_LIMIT_STORE=mongo
# Vercel edge is the only proxy in front of the function; verify the client IP the API sees.
TRUST_PROXY=1
